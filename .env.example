# Firebase web config (Firebase console > Project settings > Your apps > Web app).
# Copy to .env.local and fill in. These values are public by design: access is
# enforced by firestore.rules and storage.rules, never by hiding this config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Scripts only (scripts/*.ts, run with Node, never bundled into the app):
# absolute path to a service-account key JSON downloaded from
# Firebase console > Project settings > Service accounts. Keep it out of git.
GOOGLE_APPLICATION_CREDENTIALS=
